# Server configuration
PORT=8090

# MQTT Broker (Mosquitto / Zigbee2MQTT)
MQTT_URL=mqtt://127.0.0.1:1883
# MQTT Authentication (either MQTT_AUTH=username:password from Jeedom mqtt2, or separate fields)
MQTT_AUTH=
MQTT_USERNAME=
MQTT_PASSWORD=
Z2M_BASE_TOPIC=zigbee2mqtt

# Database & Storage
DATABASE_PATH=./data/zigbee_sentinel.db
HISTORY_RETENTION_DAYS=60

# Simulation / Mock mode
MOCK_MQTT=false
